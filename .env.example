# 복사해서 .env로 사용한다. .env는 절대 커밋하지 않는다.
OPENAI_API_KEY=

# data-pipeline 산출물 경로
AGENT_NEWS_DIR=data/raw/news
AGENT_RETURNS_PATH=data/processed/returns.parquet
# 이 서비스 산출물 경로
AGENT_CHROMA_DIR=artifacts/chroma
AGENT_RISK_TAGS_PATH=artifacts/risk_tags.jsonl

# D1·D2 (Notion 의사결정): rule/hash는 키 없이 동작하는 규칙 기반 구현
AGENT_LLM_PROVIDER=rule
AGENT_LLM_MODEL=gpt-4o-mini
AGENT_EMBEDDING_PROVIDER=hash
AGENT_EMBEDDING_MODEL=text-embedding-3-small

# 검색·Self-Correction (관련성 기준은 임베딩 모델에 맞춰 조정)
AGENT_TOP_K=6
AGENT_RELEVANCE_THRESHOLD=0.3
AGENT_MIN_RELEVANT_DOCS=2
AGENT_MAX_REWRITES=2
# D13: 5초 제한 때문에 기본값 꺼짐. 켜면 LLM 계획(+~1초), 초안 재작성(+~3초)
AGENT_LLM_PLANNER=false
AGENT_MAX_REVISIONS=0

# D4·D7: 리스크 태그 기준
AGENT_PRICE_SHOCK_Z=3.0
AGENT_EARNINGS_SHOCK_Z=2.0
AGENT_SHOCK_LOOKBACK_DAYS=60
# AGENT_RISK_TTL_DAYS={"earnings_shock":10,"regulation":30,"litigation":30,"geopolitical":10,"macro_rate":20,"price_shock":5}
